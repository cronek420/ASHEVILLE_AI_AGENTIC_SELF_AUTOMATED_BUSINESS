# Copy to .env locally and fill only the variables your project needs.
# Never commit .env files or real credential values.
APP_ENV=development

# Public intake API. Store INTAKE_HASH_KEY in Secret Manager, never here.
WORKFORCE_INTAKE_BACKEND=firestore
WORKFORCE_COLLECTION_PREFIX=workforce
ALLOWED_WEBSITE_ORIGIN=https://REPLACE_WITH_APPROVED_WEBSITE_ORIGIN
WORKFORCE_INTAKE_PUBLIC_URL=
ONBOARDING_REQUEST_RATE_LIMIT_PER_HOUR=5
ONBOARDING_REQUEST_MAX_BODY_BYTES=8192
INTAKE_HASH_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE

# Daily owner report
DAILY_REPORT_RECIPIENT=gronekthomas@gmail.com
COMMAND_CENTER_URL=https://docs.google.com/spreadsheets/d/1sq1xtu50uiNHm97db9c5-doqgatOpYkl8IQroscVCCY/edit
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1GlPw9gqABltrWVcsZda5iI1WDVifPqYH?usp=drive_link
DAILY_REPORT_APPROVAL_SUMMARY=Gate B is still pending for public deployment. Approving Gate B allows Cloud Run deployment, Firestore setup, and verification of the final public intake URL before the website is connected.
